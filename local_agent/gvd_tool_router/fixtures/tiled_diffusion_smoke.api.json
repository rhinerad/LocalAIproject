      "tile_overlap": 64,
      "tile_batch_size": 1
    }
  },
  "5": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "empty yellow corridor, fluorescent lights, sharp still",
      "clip": ["1", 1]
    }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "text, watermark, logo, blur",
      "clip": ["1", 1]
    }
  },
  "7": {
    "class_type": "VAEEncodeTiled_TiledDiffusion",
    "inputs": {
      "pixels": ["3", 0],
      "vae": ["1", 2],
