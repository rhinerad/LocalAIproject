  },
  "8": {
    "class_type": "WanVideoModelLoader",
    "inputs": {
      "model": "wan2.2_i2v_low_noise_14B_Q4_K_M.gguf",
      "base_precision": "fp16",
      "quantization": "disabled",
      "load_device": "offload_device"
    }
  },
  "9": {
    "class_type": "WanVideoSampler",
    "inputs": {
      "model": ["8", 0],
      "image_embeds": ["6", 0],
      "steps": 4,
      "cfg": 1.0,
      "shift": 5.0,
      "seed": 3,
      "force_offload": true,
      "scheduler": "euler",
      "riflex_freq_index": 0,
      "text_embeds": ["3", 0],
      "samples": ["7", 0],
