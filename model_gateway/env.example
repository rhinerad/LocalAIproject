# model_gateway/env.example — copy to model_gateway/.env (git-ignored) and fill in.
# load_config() reads model_gateway/.env but never overrides a variable already
# set in the shell, so a launcher-exported value always wins.
#
# The gateway is PLAN-ONLY: the cloud model never answers a turn and never
# calls tools. For a heavy prompt it returns a numbered text plan; the local
# Ollama model executes the whole turn with that plan in context.

# Master switch. 0 (default) = nothing ever leaves the box.
MODEL_GATEWAY_CLOUD=0

# Standard Anthropic credential. ANTHROPIC_AUTH_TOKEN is also accepted.
ANTHROPIC_API_KEY=

# Planning model (defaults shown). Used only for unpinned heavy-logic turns.
MODEL_GATEWAY_PLAN_MODEL=claude-opus-5-5
MODEL_GATEWAY_PLAN_EFFORT=high
MODEL_GATEWAY_PLAN_MAX_TOKENS=1500

# Request shaping
MODEL_GATEWAY_TIMEOUT_S=180
MODEL_GATEWAY_MAX_RETRIES=2

# Optional: aim the SDK at a local Anthropic-compatible server for adapter
# testing, e.g. Ollama's own /v1/messages. When set to a non-Anthropic host,
# effort and prompt-cache markers are not sent and the plan model should be an
# Ollama tag. ANTHROPIC_BASE_URL is honoured too (the standard SDK variable).
#MODEL_GATEWAY_BASE_URL=http://127.0.0.1:11435
#MODEL_GATEWAY_PLAN_MODEL=huihui_ai/qwen3-abliterated:8b

# Advanced (defaults: on for the official endpoint, off for a custom base URL)
#MODEL_GATEWAY_SEND_EFFORT=1
#MODEL_GATEWAY_PROMPT_CACHE=1
