# model_gateway/env.example — copy to model_gateway/.env (git-ignored) and fill in.
# load_config() reads model_gateway/.env but never overrides a variable already
# set in the shell, so a launcher-exported value always wins.

# Master switch. 0 (default) = every turn stays on local Ollama, exactly as before.
MODEL_GATEWAY_CLOUD=0

# Standard Anthropic credential. ANTHROPIC_AUTH_TOKEN is also accepted.
ANTHROPIC_API_KEY=

# Tier models (defaults shown). Heavy = unpinned logic turns + cloud-heavy pin.
# Fast = unpinned tool/code turns while ComfyUI holds the GPU + cloud-fast pin.
MODEL_GATEWAY_HEAVY_MODEL=claude-opus-5-5
MODEL_GATEWAY_HEAVY_EFFORT=high
MODEL_GATEWAY_FAST_MODEL=claude-sonnet-5-5
MODEL_GATEWAY_FAST_EFFORT=medium

# Request shaping
MODEL_GATEWAY_MAX_TOKENS=16000
MODEL_GATEWAY_TIMEOUT_S=600
MODEL_GATEWAY_MAX_RETRIES=2

# 1 = unpinned turns go to the fast tier while the GPU is busy (approved default).
MODEL_GATEWAY_BUSY_TIER=1

# Optional: aim the SDK at a local Anthropic-compatible server for proxy testing,
# e.g. Ollama's own /v1/messages. When set to a non-Anthropic host, effort and
# prompt-cache markers are not sent and the tier models should be Ollama tags.
# ANTHROPIC_BASE_URL is honoured too (the standard SDK variable).
#MODEL_GATEWAY_BASE_URL=http://127.0.0.1:11435
#MODEL_GATEWAY_HEAVY_MODEL=huihui_ai/qwen3-abliterated:8b
#MODEL_GATEWAY_FAST_MODEL=huihui_ai/qwen3-abliterated:8b

# Advanced (defaults: on for the official endpoint, off for a custom base URL)
#MODEL_GATEWAY_SEND_EFFORT=1
#MODEL_GATEWAY_PROMPT_CACHE=1
