*.sqlite
*.sqlite3
*.db
*.db-journal
*.kv
.env
.env.*
*.key
*.pem
secrets.json
credentials.json
chroma_db/

# --- local_agent generated artifacts ------------------------------------------
# Rebuilt by build_knowledge_pack.py on every launch (and by retrieval.py on
# demand), so a committed copy is stale by definition and every run left the
# tree dirty (CHANGELOG/2026-11-05a). Chat .lock files are OS lock handles,
# not records; the chat .json transcripts are deliberately NOT ignored.
local_agent/knowledge/EQUAL_SHARES_REFERENCE.md
local_agent/knowledge/PROJECT_STATE.json
local_agent/knowledge/retrieval_index.json
local_agent/knowledge/retrieval_embeddings.json
local_agent/knowledge/*.tmp
local_agent/knowledge/.fuse_hidden*
local_agent/chats/*.lock

# --- OS / editor cruft --------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.vscode/
.idea/
*.log.old

# --- Debug output is explicitly text and kept syncable ------------------------
!debug/**
!debug/*.txt
