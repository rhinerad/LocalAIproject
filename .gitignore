# --- Renders / output media ---------------------------------------------------
output/
outputs/
**/output/
**/outputs/
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.flv
*.wmv
*.m4v

# NOTE: image types are deliberately NOT blanket-ignored. This project has no
# render/cache directories at all (verified), so all 4,741 local .png files are
# UI icons and DSPy evaluation frames that belong in git. Blanket-ignoring
# *.png/*.jpg would silently drop 4,741 tracked UI/eval assets.
*.psd
*.tif
*.tiff

# --- Live runtime state (rewritten on a timer by resident services) ------------
# local_agent/runtime/ is a live working directory: resident services rewrite gate
# decisions, GPU ownership, media pressure, render watches and traces in it
# continuously. Committing it is noise that collides on every pull. The same
# goes for worker_farm/runtime/, which holds live Celery/farm state.
# Runtime evidence that matters is copied into a CHANGELOG entry at the time.
local_agent/runtime/
**/local_agent/runtime/
# NOTE: local_agent/sandbox/ (run_code isolation dirs) and local_agent/uploads/
# (operator attachments) are deliberately kept syncable: uploads can be the
# only copy of an input the operator sent, and sandbox runs are audit evidence
# for what the model executed.
worker_farm/runtime/
**/worker_farm/runtime/

# --- Virtual environments / caches --------------------------------------------
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/
node_modules/
.ipynb_checkpoints/

# --- Large archives ------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz

# --- Third-party vendored source ----------------------------------------------
# local_agent/vendor/LXMF, RNS, serial, CRNS, bin and three dist-info folders
# are upstream Reticulum/LXMF packages pinned by local_agent/requirements*.txt
# and re-installable from those pins. Committing them is 25 MB of someone
# else's code, with their own licenses, that drifts from the pins.
local_agent/vendor/
**/local_agent/vendor/
# local_agent/vendor_sideband is the official Sideband source kept as the base
# for a local derivative APK (CC BY-NC-SA). It is ~13 MB of upstream Kivy/
# Android project, re-obtainable from upstream, and the local overlay that
# matters is documented in SIDEBAND_TIER_B_BUILD.md and CHANGELOG. Keep it
# local only.
local_agent/vendor_sideband
**/local_agent/vendor_sideband

# --- Worker-farm Mac bundles --------------------------------------------------
# tools/worker_farm_mac/ holds two fat Python wheels (numpy + sentence-
# transformers deps, ~115 MB) plus the Mac worker's own local .venv.
# The worker installs them from requirements on the Mac; keeping them in git
# only inflates every clone.
tools/worker_farm_mac/*.whl
tools/worker_farm_mac/**/*.whl
tools/worker_farm_mac/.venv/
tools/worker_farm_mac/**/.venv/

# --- Misc binaries that landed in the tree ------------------------------------
# Captured during setup; not source. Re-obtainable from the upstream project.
local_agent/Sideband_2.0.1_Windows.zip
**/Sideband_2.0.1_Windows.zip
*.exe
*.msi
*.dll
*.so
*.dylib
*.apk
*.iso
*.img
*.dmg

